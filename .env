# ---------- DATA ----------
DATA_PATH=/Users/boris/Desktop/research/segmentation_hsbc/ST138D-XLS-ENG.xlsx
SHEET_NAME=Synthetic Data
OUTPUT_DIR=outputs

# ---------- REPRODUCIBILITY ----------
RANDOM_STATE=42

# ---------- K SEARCH ----------
# K_MIN=3 because k=2 is rarely useful for personas. Set it to 2 if you want to test it.
K_MIN=3
K_MAX=10
MIN_CLUSTER_SHARE=0.03

# ---------- COMPUTE BUDGET (sampling for O(n^2) steps) ----------
SAMPLE_SIZE=8000
HC_SAMPLE=6000
STABILITY_SAMPLE=20000
CONSENSUS_SAMPLE=5000
N_BOOTSTRAP=20
N_NULL=20

# ---------- MODELLING ----------
# 1.0 => one product difference ~ one SD of (transformed) income/TRB
BINARY_WEIGHT=1.0
FAMD_VAR_TARGET=0.85
N_JOBS=-1